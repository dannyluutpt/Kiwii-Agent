{
  "name": "@kiwii/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kiwii web app frontend: chat and image generation SPA served by @kiwii/api.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
